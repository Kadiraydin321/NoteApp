<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_note"
        android:enabled="true"
        android:icon="@drawable/ic_widget_add"
        android:shortcutShortLabel="@string/shortcut_quick_note"
        android:shortcutLongLabel="@string/shortcut_quick_note_long">
        <intent
            android:action="com.example.noteapp.ACTION_QUICK_NOTE"
            android:targetPackage="com.example.noteapp"
            android:targetClass="com.example.noteapp.MainActivity">
            <extra android:name="open_new_note" android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="quick_todo"
        android:enabled="true"
        android:icon="@drawable/ic_widget_check"
        android:shortcutShortLabel="@string/shortcut_quick_todo"
        android:shortcutLongLabel="@string/shortcut_quick_todo_long">
        <intent
            android:action="ACTION_CHECKLIST"
            android:targetPackage="com.example.noteapp"
            android:targetClass="com.example.noteapp.MainActivity">
            <extra android:name="extra_action_type" android:value="ACTION_CHECKLIST" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="quick_voice"
        android:enabled="true"
        android:icon="@drawable/ic_widget_mic"
        android:shortcutShortLabel="@string/shortcut_quick_voice"
        android:shortcutLongLabel="@string/shortcut_quick_voice_long">
        <intent
            android:action="ACTION_VOICE"
            android:targetPackage="com.example.noteapp"
            android:targetClass="com.example.noteapp.MainActivity">
            <extra android:name="extra_action_type" android:value="ACTION_VOICE" />
        </intent>
    </shortcut>
</shortcuts>
