<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_1x1_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_fab_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_1x1_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Yeni Not" />

        <TextView
            android:id="@+id/widget_1x1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</FrameLayout>
