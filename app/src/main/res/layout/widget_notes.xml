<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:padding="12dp">

    <!-- Üst Başlık ve Yenile Butonu -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notlarım"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1C1B1F" />

            <TextView
                android:id="@+id/widget_subtitle_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tüm Notlar"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#6750A4" />
        </LinearLayout>

        <!-- Yenile Butonu -->
        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Yenile"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Notlar Listesi Alanı -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp">

        <ListView
            android:id="@+id/widget_notes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:scrollbars="none" />

        <!-- Boş Liste Görünümü -->
        <TextView
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Henüz not bulunmuyor.\nAşağıdaki butonlardan hemen ekleyebilirsiniz."
            android:textSize="13sp"
            android:textColor="#79747E"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Google Keep Tarzı Alt Hızlı Ekleme Barı (Listeyle çakışmaz, kesilme yapmaz) -->
    <LinearLayout
        android:id="@+id/widget_floating_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_floating_bar_bg"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <!-- 1. Liste / Onay Kutusu (To-Do) -->
        <ImageButton
            android:id="@+id/widget_btn_add_todo"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="Yapılacaklar Listesi"
            android:scaleType="centerInside" />

        <!-- 2. Çizim Notu -->
        <ImageButton
            android:id="@+id/widget_btn_add_draw"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_draw"
            android:contentDescription="Çizim Notu"
            android:scaleType="centerInside" />

        <!-- 3. Ses Notu -->
        <ImageButton
            android:id="@+id/widget_btn_add_voice"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="Ses Notu"
            android:scaleType="centerInside" />

        <!-- 4. Görsel Notu -->
        <ImageButton
            android:id="@+id/widget_btn_add_image"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_image"
            android:contentDescription="Görsel Notu"
            android:scaleType="centerInside" />

        <!-- 5. Yeni Metin Notu (+) FAB Butonu -->
        <LinearLayout
            android:id="@+id/widget_btn_add_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_fab_bg"
            android:gravity="center"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/widget_fab_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_add"
                android:contentDescription="Yeni Not" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
