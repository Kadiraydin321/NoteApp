<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Dinamik Renklendirilen Yuvarlak Arka Plan (Radius Asla Bozulmaz) -->
    <ImageView
        android:id="@+id/widget_item_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_item_background"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp">

        <!-- Üst Satır: Başlık ve Rozetler -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not Başlığı"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:textColor="#1D1B20"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_item_pin"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_pin"
                android:contentDescription="Sabitli"
                android:visibility="gone"
                android:layout_marginStart="4dp" />

            <ImageView
                android:id="@+id/widget_item_lock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_lock"
                android:contentDescription="Kilitli"
                android:visibility="gone"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- İçerik Özeti -->
        <TextView
            android:id="@+id/widget_item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not içeriği burada kısa bir özet olarak görüntülenir..."
            android:textSize="11.5sp"
            android:textColor="#49454F"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</FrameLayout>
